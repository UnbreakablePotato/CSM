<Page x:Class="csm.Client.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:csm.Client.Views"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1200"
      Title="HomePage">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/CSMBlue.jpg"
                    Stretch="UniformToFill"/>
        </Grid.Background>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="379,0,387,0">
            <ComboBox Width="80"
              Height="30"
              VerticalContentAlignment="Center"
              HorizontalContentAlignment="Center"
              FontSize="18"
              FontFamily="pack://application:,,,/YourAssemblyName;component/Fonts/#Exo 2"
              FontWeight="bold"
              SelectedIndex="0">
                <ComboBoxItem Content="EUW"/>
                <ComboBoxItem Content="EUNE"/>
                <ComboBoxItem Content="NA"/>
                <ComboBoxItem Content="KR"/>
            </ComboBox>

            <TextBox x:Name="GameNameBox" Width="200" Height="30" FontFamily="pack://application:,,,/YourAssemblyName;component/Fonts/#Exo 2" Margin="10" ToolTip="gamename" VerticalContentAlignment="Center"/>

            <TextBlock Text="#" Margin="0" VerticalAlignment="Center" FontSize="26"/>

            <TextBox x:Name="TagBox" Width="100" Height="30" FontFamily="pack://application:,,,/YourAssemblyName;component/Fonts/#Exo 2" Margin="10" ToolTip="tag" VerticalContentAlignment="Center"/>



            <TextBox KeyDown="Search_KeyDown"/>

        </StackPanel>



        <Image
Source="/Resources/CSMLogoRefined.png"
Stretch="Uniform" Margin="300,-4,324,318" RenderTransformOrigin="0.58,1.399"/>



    </Grid>
</Page>
