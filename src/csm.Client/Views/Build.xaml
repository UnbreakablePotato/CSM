<Page x:Class="csm.Client.Views.Build"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:csm.Client.Views"
      xmlns:vm="clr-namespace:csm.Client.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      d:DataContext="{d:DesignInstance Type=vm:Build}"
      Title="Build">

    <Page.Resources>
        <!-- Shared Styles -->
        <ImageSource x:Key="FallBackImage">C:\Users\sande\source\repos\UnbreakablePotato\CSM\src\csm.Client\Resources\FallBackIcon.png</ImageSource>

        <!-- Dynamic Icon Binding -->
        <!-- Use this like: Source="{Binding ChampionIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" -->

        <Style x:Key="SubTabButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A0A8B5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Static highlight styling for current selection (or wire triggers) -->
        <Style x:Key="ActiveSubTab" TargetType="Button" BasedOn="{StaticResource SubTabButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#51A3FE"/>
        </Style>

        <Style x:Key="MetricNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A9CB3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A9CB3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/CSMBlue.jpg" Stretch="UniformToFill"/>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,24" MaxWidth="1100">

                <!-- 1. Champion Header Area -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="12" Width="80" Height="80" BorderThickness="1" BorderBrush="#33FFFFFF" ClipToBounds="True" Grid.Column="0">
                        <Image Source="{Binding ChampionIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding ChampionName, FallbackValue='Malphite'}" Foreground="#FFFFFF" FontSize="28" FontWeight="ExtraBold"/>
                            <TextBlock Text="{Binding PageSubTitle, FallbackValue='Build, Runes and Counters, 16.23'}" Foreground="#A0A8B5" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,4" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <!-- Abilities List (Optional implementation placeholder) -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Image Source="{Binding PassIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,4,0"/>
                            <Image Source="{Binding QIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,4,0"/>
                            <Image Source="{Binding WIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,4,0"/>
                            <Image Source="{Binding EIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,4,0"/>
                            <Image Source="{Binding RIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,4,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 2. Sub-Tab Row & Filter Bar -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Subtabs -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Button Content="Build" Style="{StaticResource ActiveSubTab}"/>
                        
                        <Button Content="Matchups" Style="{StaticResource SubTabButton}"/>
                        
                    </StackPanel>

                    <!-- Mock Filters -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#1D2D50" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="RANKED" Foreground="#A3C7FC" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        
                    </StackPanel>
                </Grid>

                <!-- 3. Metrics Summary Banner (Subtle dark background) -->
                <Border CornerRadius="8" Background="#4D102D50" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="20,14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rank Info -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Rank, FallbackValue='2 / 49'}" Style="{StaticResource MetricNumber}"/>
                            <TextBlock Text="RANK" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>

                        <!-- Winrate Info -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding WinRate, StringFormat={}{0:P1}, FallbackValue='51.2%'}" Style="{StaticResource MetricNumber}"/>
                            <TextBlock Text="WINRATE" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>

                        <!-- Pickrate Info -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding PickRate, StringFormat={}{0:P1}, FallbackValue='6.8%'}" Style="{StaticResource MetricNumber}"/>
                            <TextBlock Text="PICKRATE" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>

                        <!-- Games Count -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding GamesPlayed, StringFormat={}{0:N0}, FallbackValue='37,206'}" Style="{StaticResource MetricNumber}"/>
                            <TextBlock Text="GAMES" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Build Header / Import Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <Border CornerRadius="6" Background="#2E446E" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding SelectedBuildIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BuildName, FallbackValue='Recommended Build'}" Foreground="#FFFFFF" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Content="ONE-CLICK IMPORT" Grid.Column="1" Background="#FECE3E" Foreground="#102D50" FontWeight="ExtraBold" FontSize="12" Padding="16,8" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- 4. Detailed Runes, Summs, & Items Area -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- A. Runes Grid Section -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="RUNES" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <!-- Primary Tree -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Image Source="{Binding PrimaryTreeIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="32" Height="32" Margin="0,0,0,8"/>
                                <Image Source="{Binding KeystoneIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="32" Height="32" Margin="0,0,0,4"/>
                                <Image Source="{Binding PrimaryRune1Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Opacity="0.3" Margin="0,0,0,4"/>
                                <Image Source="{Binding PrimaryRune2Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,0,4"/>
                                <Image Source="{Binding PrimaryRune3Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,0,4"/>
                            </StackPanel>

                            <!-- Divider (Decorative vertical line) -->
                            <Border Grid.Column="1" Background="#15FFFFFF" Width="1" HorizontalAlignment="Center" Margin="0,10"/>

                            <!-- Secondary Tree -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Image Source="{Binding SecondaryTreeIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="26" Height="26" Margin="0,4,0,12"/>
                                <Image Source="{Binding SecondaryRune1Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,0,4"/>
                                <Image Source="{Binding SecondaryRune2Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Opacity="0.3" Margin="0,0,0,4"/>
                                <Image Source="{Binding SecondaryRune3Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- B. Summoners, Spell Order -->
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="SUMMONERS" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Image Source="{Binding Spell1Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28" Margin="0,0,6,0"/>
                            <Image Source="{Binding Spell2Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                        </StackPanel>

                        <TextBlock Text="SPELL ORDER" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding SpellQIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24"/>
                            <TextBlock Text="&gt;" Foreground="#5A6B82" VerticalAlignment="Center" Margin="4,0"/>
                            <Image Source="{Binding SpellEIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24"/>
                            <TextBlock Text="&gt;" Foreground="#5A6B82" VerticalAlignment="Center" Margin="4,0"/>
                            <Image Source="{Binding SpellWIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="24" Height="24"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- C. Equipment / Item Build Stack -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ITEMS &amp; BUILD PATH" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Starter Items -->
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Starter" Foreground="#8A9CB3" FontSize="11" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding StartItem1Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28" Margin="0,0,6,0"/>
                                    <Image Source="{Binding StartItem2Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Boots Selection -->
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="Boots" Foreground="#8A9CB3" FontSize="11" Margin="0,0,0,6"/>
                                <Image Source="{Binding BootsIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                            </StackPanel>

                            <!-- Main Recommended Path -->
                            <StackPanel>
                                <TextBlock Text="Full Build Path" Foreground="#8A9CB3" FontSize="11" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding MythicIcon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                                    <TextBlock Text="&gt;" Foreground="#5A6B82" VerticalAlignment="Center" Margin="6,0"/>
                                    <Image Source="{Binding Item2Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                                    <TextBlock Text="&gt;" Foreground="#5A6B82" VerticalAlignment="Center" Margin="6,0"/>
                                    <Image Source="{Binding Item3Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                                    <TextBlock Text="&gt;" Foreground="#5A6B82" VerticalAlignment="Center" Margin="6,0"/>
                                    <Image Source="{Binding Item4Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                                    <TextBlock Text="&gt;" Foreground="#5A6B82" VerticalAlignment="Center" Margin="6,0"/>
                                    <Image Source="{Binding Item5Icon, TargetNullValue={StaticResource FallBackImage}, FallbackValue={StaticResource FallBackImage}}" Width="28" Height="28"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>