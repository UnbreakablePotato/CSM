<Page x:Class="csm.Client.Views.Tierlists"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:csm.Client.Views"
      xmlns:vm="clr-namespace:csm.Client.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=vm:TierlistViewModel}"
      Title="Tierlists">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="279*"/>
            <ColumnDefinition Width="121*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/CSMBlue.jpg"
            Stretch="UniformToFill"/>
        </Grid.Background>

        <ItemsControl ItemsSource="{Binding Champions}" Grid.ColumnSpan="2">

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Rank}"
                           Grid.Column="0"/>

                        <TextBlock Text="{Binding Name}"
                           Grid.Column="1"/>

                        <TextBlock Text="{Binding WinRate,
                    StringFormat={}{0:P2}}"
                           Grid.Column="2"/>

                        <TextBlock Text="{Binding PickRate,
                    StringFormat={}{0:P2}}"
                           Grid.Column="3"/>

                        <TextBlock Text="{Binding GamesPlayed}"
                                   Foreground="Black"
                                   FontSize="20"
                           Grid.Column="4"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Grid>
</Page>
