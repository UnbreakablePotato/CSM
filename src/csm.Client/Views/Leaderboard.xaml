<Page x:Class="csm.Client.Views.Leaderboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:csm.Client.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Leaderboard">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/CSMBlue.jpg"
             Stretch="UniformToFill"/>
        </Grid.Background>

        <Button Margin="-10,-15,744,401" RenderTransformOrigin="0.44,0.18">
            <Button.Template>
                <ControlTemplate>
                    <Image Source="/Resources/CSMLogoRefined.png"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Page>
